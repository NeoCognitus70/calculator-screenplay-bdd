{
  "name": "calculator-screenplay-bdd",
  "version": "0.2.0",
  "description": "A pedagogical calculator application tested with Playwright, BDD, and a hand-baked Screenplay Pattern implementation.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preflight:screenplay": "node scripts/preflight-screenplay.mjs",
    "prepare:screenplay": "node scripts/preflight-screenplay.mjs && cd ../hand-baked-screenplay-pattern && npm ci && npm run build",
    "dev": "npm run build && node --max-old-space-size=4096 dist/startServer.js",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "bddgen": "node --max-old-space-size=4096 ./node_modules/playwright-bdd/dist/cli/index.js",
    "test": "npm run bddgen && node --max-old-space-size=4096 ./node_modules/@playwright/test/cli.js test --workers=1",
    "test:unit": "node --max-old-space-size=4096 ./node_modules/@playwright/test/cli.js test --project=unit-and-api --workers=1",
    "test:bdd": "npm run bddgen && node --max-old-space-size=4096 ./node_modules/@playwright/test/cli.js test --project=bdd --workers=1",
    "docs:api": "npm run build && node scripts/generate-api-docs.mjs",
    "check:api-docs": "npm run build && node scripts/check-api-docs.mjs",
    "verify": "node scripts/preflight-screenplay.mjs --built && npm run typecheck && npm run build && node scripts/check-api-docs.mjs && npm test"
  },
  "dependencies": {
    "hand-baked-screenplay-pattern": "file:../hand-baked-screenplay-pattern"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.10.0",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.7.0"
  }
}
